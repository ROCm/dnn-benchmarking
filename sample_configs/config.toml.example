# Complete dnn-benchmark config example: every config key is listed here.
#
# Explicit CLI flags override config values (booleans too: --no-verbose,
# --no-autotune, ...), so this file works as a base recipe:
#   dnn-benchmark --config sample_configs/config.toml.example --iters 500
#
# Relative paths are resolved from this config file's directory.

# Config schema version. Only version 1 is supported.
version = 1

# --- Input -------------------------------------------------------------------
# Graph JSON files, directories, globs or tarballs (--graph/-g replaces this).
graphs = [
  "../graphs/sample_conv_fwd.json",
]

# --- Run ---------------------------------------------------------------------
warmup = 10          # untimed warmup launches per engine
iters = 100          # minimum timed iterations per engine
min_time_ms = 0.0    # keep timing until summed kernel time reaches this (0 = exactly iters)
cache_mode = "warm"  # "warm" or "cold" (flush L2/MALL before each timed iteration)
timing_block = 1     # launches per timed sample; N > 1 = rocKE block timing (warm cache only)
seed = 0             # random seed for input data

# --- Runtime / selection -----------------------------------------------------
runtime = "hipdnn"   # "hipdnn" or "pytorch"

# Plugin directory, or a list matching the [[engines]] order. setup_env.py
# prints the selected prefix; defaults to $ROCM_PATH/lib/hipdnn_plugins/engines
# or the pip ROCm SDK.
# plugin_path = "<selected-prefix>/lib/hipdnn_plugins/engines"

autotune = false     # benchmark candidate kernels and cache the winner
# hipdnn_cache_dir = "/tmp/dnn-bench-hipdnn-cache"  # per-run HIPDNN_CACHE_DIR

pytorch_sdpa_backend = "default"  # default, flash, math, efficient, cudnn, overrideable
# pytorch_rocm_fa_library = "aotriton"  # requires pytorch_sdpa_backend = "flash"

# --- Validation --------------------------------------------------------------
validate = "none"    # "none" or "pytorch"
# Tolerances default to dtype-aware values; set only to override them.
# rtol = 1e-3
# atol = 1e-3

# --- Comparison --------------------------------------------------------------
# Also build and time a global.benchmarking=1 plan per engine, and a tuned
# PyTorch run in a child process. Significantly slower. Not with autotune.
oracle = false

# --- Output ------------------------------------------------------------------
output = "/tmp/dnn-benchmark-results.json"  # .csv writes CSV
compact_json = false  # true drops all JSON whitespace (default: one-space indent)
verbose = false
quiet = false
metrics = true       # FLOPs/IO, workspace, host and GPU snapshots

# --- Profiling (each enabled pass re-runs the workload under a tool) ---------
# pmc = "basic"         # "basic", "memory", "flops" or "all"
pmc_allow_multipass = false  # required for pmc = "all"
trace = false        # Perfetto kernel/memcpy trace
perf = false
roofline = false
# profiling_output_dir = "/tmp/dnn-benchmark-profiling"
profiling_timeout = 600  # seconds per profiler subprocess; 0 disables

# --- Engine matrix -------------------------------------------------------------
# Ordered engine selections: id is an engine name, a decimal ID, or a "0x..."
# hex ID. If any entry sets plugin_path, every entry must, and top-level
# plugin_path must be unset. --engine or --plugin-path on the CLI replaces the
# whole matrix; a top-level plugin_path is kept when only --engine is given.
#
# [[engines]]
# id = "MIOPEN_ENGINE"
# plugin_path = "<selected-prefix>/lib/hipdnn_plugins/engines"
#
# [[engines]]
# id = "MIOPEN_ENGINE"
# plugin_path = "/path/to/alternate/hipdnn_plugins/engines"
